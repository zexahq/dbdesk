{
  "name": "dbdesk",
  "version": "0.1.9",
  "private": true,
  "description": "The cleanest database management tool for your databases.",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=@dbdesk/desktop",
    "dev:server": "turbo run dev --filter=@dbdesk/server",
    "dev:web": "turbo run dev --filter=@dbdesk/web",
    "clean": "rm -rf .turbo node_modules apps/*/.turbo apps/*/.next apps/*/.source apps/*/node_modules apps/*/dist packages/*/.turbo packages/*/.next packages/*/node_modules packages/*/dist",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2.8.11",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "better-call": "1.3.2"
    }
  }
}

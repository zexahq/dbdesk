{
  "name": "dbdesk",
  "version": "0.1.6",
  "private": true,
  "description": "The cleanest database management tool for your databases.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=@dbdesk/desktop",
    "dev:server": "turbo run dev --filter=@dbdesk/server",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2.8.11",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
